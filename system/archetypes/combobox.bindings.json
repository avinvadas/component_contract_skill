{
  "comment": "iOS has no native combobox, so every entry binds against semantics an implementation must produce by hand. That is the point: not free does not mean not required.",
  "archetype": "combobox", "version": "1.0",
  "bindings": {
    "CBX-01": { "web": { "expect": { "equals": "combobox" } }, "ios": { "expect": { "equals": "combobox" } }, "android": { "expect": { "equals": "combobox" } }, "macos": { "expect": { "equals": "combobox" }, "also": { "identity": { "one_of": ["AXComboBox"] } } } },
    "CBX-02": { "web": { "expect": { "present": true } }, "ios": { "expect": { "present": true } }, "android": { "expect": { "present": true } }, "macos": { "expect": { "present": true } } },
    "CBX-03": { "web": { "expect": { "contains": "expanded" } }, "ios": { "expect": { "contains": "expanded" } }, "android": { "expect": { "contains": "expanded" } }, "macos": { "expect": { "contains": "expanded" } } },
    "CBX-04": { "web": { "expect": { "contains": "candidates" } }, "ios": { "expect": { "contains": "candidates" } }, "android": { "expect": { "contains": "candidates" } }, "macos": { "expect": { "contains": "candidates" } } },
    "CBX-05": { "web": { "expect": { "contains": "active-candidate" } }, "ios": { "expect": { "contains": "active-candidate" } }, "android": { "expect": { "contains": "active-candidate" } }, "macos": { "expect": { "contains": "active-candidate" } } },
    "CBX-06": {
      "web":     { "expect": { "equals": "moved" }, "trigger": ["key:ArrowDown", "key:ArrowUp"] },
      "ios":     { "expect": { "equals": "moved" }, "trigger": "a11y:swipe" },
      "android": { "expect": { "equals": "moved" }, "trigger": ["key:ArrowDown", "dpad:down"] },
      "macos":   { "expect": { "equals": "moved" }, "trigger": ["key:ArrowDown", "key:ArrowUp"] }
    },
    "CBX-07": {
      "web":     { "expect": { "equals": "closed-uncommitted" }, "trigger": "key:Escape" },
      "ios":     { "expect": { "equals": "closed-uncommitted" }, "trigger": "gesture:tap-outside" },
      "android": { "expect": { "equals": "closed-uncommitted" }, "trigger": "system:back" },
      "macos":   { "expect": { "equals": "closed-uncommitted" }, "trigger": "key:Escape" }
    },
    "CBX-08": { "web": { "expect": { "equals": "committed" }, "trigger": "activate" }, "ios": { "expect": { "equals": "committed" }, "trigger": "activate" }, "android": { "expect": { "equals": "committed" }, "trigger": "activate" }, "macos": { "expect": { "equals": "committed" }, "trigger": "activate" } },
    "CBX-09": { "web": { "expect": { "contains": "editable" } }, "ios": { "expect": { "contains": "editable" } }, "android": { "expect": { "contains": "editable" } }, "macos": { "expect": { "contains": "editable" } } }
  }
}
